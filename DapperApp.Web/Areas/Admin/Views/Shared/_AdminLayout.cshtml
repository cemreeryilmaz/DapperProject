@using DapperApp.Web.Models.Sales
@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SalesPulse</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/salespulse.css" asp-append-version="true" />
</head>
<body class="sp-body">
    <aside class="sp-sidebar">
        <div class="sp-brand">
            <div class="sp-mark">SP</div>
            <div>
                <strong>SalesPulse</strong>
                <span>Satış operasyonları</span>
            </div>
        </div>
        <nav class="sp-nav">
            <a class="@(current == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                Gösterge paneli
            </a>
            <a class="@(current == "OrderExplorer" ? "active" : "")" asp-area="Admin" asp-controller="OrderExplorer" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6L5 3H2"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/></svg>
                Sipariş yönetimi
            </a>
            <a class="@(current == "SalesIntelligence" ? "active" : "")" asp-area="Admin" asp-controller="SalesIntelligence" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19V5"/><path d="M4 19h16"/><path d="M8 15l3-4 3 2 5-7"/></svg>
                Satış analizi
            </a>
        </nav>
    </aside>
    <div class="sp-overlay"></div>
    <div class="sp-main">
        <header class="sp-topbar">
            <button class="sp-icon-btn sp-menu-btn" type="button" aria-label="Menü">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </button>
            <form class="sp-search" asp-area="Admin" asp-controller="OrderExplorer" asp-action="Index" method="get">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                <input type="search" name="search" placeholder="Sipariş no veya müşteri ara" aria-label="Sipariş ara" />
            </form>
            <div class="sp-top-actions">
                @await Component.InvokeAsync("AdminChrome")
                <div class="dropdown">
                    <button class="sp-profile" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="sp-avatar">SP</span>
                        <span><b>Yönetici</b><small>Yerel oturum</small></span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end sp-menu">
                        <span class="dropdown-item-text">SalesPulse yönetim paneli</span>
                    </div>
                </div>
            </div>
        </header>
        <main class="sp-content">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/salespulse.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
